#
save__reflns.pdbx_orthogonalization_convention
   _item_description.description  
;             Description of orthogonalization convention used. The
              notation can make use of unit cell axes "a", "b" and "c"
              and the reciprocal unit cell axes "astar", "bstar" and
              "cstar". Upper case letters "X", "Y" and "Z" denote the
              orthogonal axes, while lower case "x" stands for "cross
              product".
;

   #
   _item.name            "_reflns.pdbx_orthogonalization_convention"
   _item.category_id     reflns
   _item.mandatory_code  no
   #
   _item_type.code  code
   #
   _item_enumeration.value   pdb
   _item_enumeration.detail  "X along a, Y along (cstar x a), Z along cstar, with origins conincident"
   #
   _item_aliases.alias_name  "_reflns.gphl_orthogonalization_convention"
   _item_aliases.dictionary  gphl-proc-aniso-extension.dic
   _item_aliases.version     0.0
   #
