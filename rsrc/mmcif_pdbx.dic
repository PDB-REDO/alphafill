   _pdbx_item_enumeration.name
   _pdbx_item_enumeration.value
   _pdbx_item_enumeration.detail
     "_entity.type"  macrolide    .  
     "_entity.type"  non-polymer  .  
     "_entity.type"  polymer      .  
     "_entity.type"  branched     .  
     "_entity.type"  water        .  
