    _pdbx_diffrn_orientation.type
    1 69.373940 -130.908295 27.435501 79.867874 119.642296 -44.824940 14.660122 30.056683 106.345345 'Unit cell axis directions'
    2 0.04013 -0.296 0.9543 -0.5429 0.7953 0.2695 -0.8388 -0.529 -0.1288 'U matrix'
;

