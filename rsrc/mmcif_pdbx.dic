    _phasing_MIR_der_refln.index_l        25
    _phasing_MIR_der_refln.der_id         HGPT1
    _phasing_MIR_der_refln.set_id       'NS1-96'
    _phasing_MIR_der_refln.F_calc_au     106.66
    _phasing_MIR_der_refln.F_meas_au     204.67
