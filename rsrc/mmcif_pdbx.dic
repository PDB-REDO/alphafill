     "_pdbx_nmr_sample_details.solvent_system"  chloroform                .  
     "_pdbx_nmr_sample_details.solvent_system"  DMSO                      .  
     "_pdbx_nmr_sample_details.solvent_system"  ethanol/water             .  
     "_pdbx_nmr_sample_details.solvent_system"  methanol                  .  
     "_pdbx_nmr_sample_details.solvent_system"  "trifluoroacetic acid"    .  
     "_pdbx_nmr_sample_details.solvent_system"  trifluoroethanol/water    .  
