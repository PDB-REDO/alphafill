   _item_enumeration.value
   _item_enumeration.detail
     polymer      "entity is a polymer"  
     non-polymer  "entity is not a polymer"  
     macrolide    "entity is a macrolide"  
     water        "water in the solvent model"  
     branched     "entity is branched"  
   #
