     "_pdbx_nmr_ensemble.conformer_selection_criteria"  "structures with the lowest energy"                            .  
     "_pdbx_nmr_ensemble.conformer_selection_criteria"  "structures with the least restraint violations"               .  
     "_pdbx_nmr_ensemble.conformer_selection_criteria"  "structures with acceptable covalent geometry"                 .  
     "_pdbx_nmr_ensemble.conformer_selection_criteria"  "structures with favorable non-bond energy"                    .  
     "_pdbx_nmr_ensemble.conformer_selection_criteria"  "target function"                                              .  
