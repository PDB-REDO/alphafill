   _category_group.id
     inclusive_group  
     struct_group     
     pdbx_group       
   #
   _category_examples.detail  
;
    Example 1 -
;

   _category_examples.case    
;
    _pdbx_struct_legacy_oper_list.id              2
    _pdbx_struct_legacy_oper_list.matrix[1][1]    0.247
    _pdbx_struct_legacy_oper_list.matrix[1][2]    0.935
    _pdbx_struct_legacy_oper_list.matrix[1][3]    0.256
    _pdbx_struct_legacy_oper_list.matrix[2][1]    0.929
    _pdbx_struct_legacy_oper_list.matrix[2][2]    0.153
    _pdbx_struct_legacy_oper_list.matrix[2][3]    0.337
    _pdbx_struct_legacy_oper_list.matrix[3][1]    0.276
    _pdbx_struct_legacy_oper_list.matrix[3][2]    0.321
    _pdbx_struct_legacy_oper_list.matrix[3][3]   -0.906
    _pdbx_struct_legacy_oper_list.vector[1]      -8.253
    _pdbx_struct_legacy_oper_list.vector[2]     -11.743
    _pdbx_struct_legacy_oper_list.vector[3]      -1.782
;

