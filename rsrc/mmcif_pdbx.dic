;
    Example 1 -
;

   _category_examples.case    
;
    _pdbx_contact_author.id                1
    _pdbx_contact_author.name_salutation   'Dr.'
    _pdbx_contact_author.name_first        'Paula'
    _pdbx_contact_author.name_last         'Fitzgerald'
