;
    loop_
    _pdbx_diffrn_orientation.id
    _pdbx_diffrn_orientation.matrix[1][1]
    _pdbx_diffrn_orientation.matrix[1][2]
    _pdbx_diffrn_orientation.matrix[1][3]
    _pdbx_diffrn_orientation.matrix[2][1]
    _pdbx_diffrn_orientation.matrix[2][2]
