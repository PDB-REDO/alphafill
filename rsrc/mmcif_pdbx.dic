    _cell_measurement.entry_id             '5HVP'
    _cell_measurement.temp                 293
    _cell_measurement.temp_esd             3
    _cell_measurement.theta_min            11
    _cell_measurement.theta_max            31
    _cell_measurement.wavelength           1.54
;
  
     
