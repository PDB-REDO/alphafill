   _pdbx_item_description.description  "The overall standard uncertainty (estimated standard deviation) of the displacement parameters based on the crystallographic R value, expressed in a formalism known as the dispersion precision indicator (DPI)"
   #
   loop_
   _pdbx_item_range.name
   _pdbx_item_range.minimum
   _pdbx_item_range.maximum
